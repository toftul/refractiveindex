    title: "Refractiveindex.info database of optical constants"
    authors:
      - family-names: Polyanskiy
        given-names: Mikhail N.
    journal: "Scientific Data"
    volume: 11
    start: 94
    year: 2024
    doi: 10.1038/s41597-023-02898-2
